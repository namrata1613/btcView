SCript used - 

#!/usr/bin/env bash

# Agent B gate:
# (1) ANCHOR-safety - ceiling path inert under uniform tier =>
#     98.542/98.282/98.000 at 20/40/60K (priority, ceiling-disabled AND
#     ceiling>=horizon) + fifo byte-parity;
# (2) FUNCTIONAL - finite tight ceiling with a deferring workload
#     force-drains past-ceiling units, tracks backlog, survives exit(0).
#
# Usage:
#   bash run_2e_ceiling_check.sh anchor       # the 3 anchor legs
#   bash run_2e_ceiling_check.sh functional   # ceiling-fires + durability

set -euo pipefail

MODE="${1:-anchor}"

ROOT=~/research
REPO=$ROOT/FreshDiskANN-baseline
BT=$REPO/build/tests
DATA=$ROOT/data/sift1m
QUERY=$DATA/sift_query.bin

N0=100000
STEP=100
MS=20000
seed_save() {    # $1 = work dir
    local W="$1"

    local G0
    G0=$(ls "$ROOT/work/sift100k_idx"/*_disk.index | head -1)
    G0=${G0%_disk.index}

    local PFX
    PFX=$(basename "$G0")

    rm -rf "$W"
    mkdir -p "$W"

    for s in \
        _disk.index \
        _disk.index.tags \
        _pq_compressed.bin \
        _pq_pivots.bin \
        _medoids.bin \
        _sample_data.bin
    do
        [ -f "${G0}${s}" ] && cp -f "${G0}${s}" "$W/${PFX}${s}"
    done

    rm -f \
        "$W/${PFX}"_mem* \
        "$W/${PFX}"_merge* \
        "$W/${PFX}"_shadow* \
        2>/dev/null || true

    [ -f "$W/${PFX}_disk.index.tags" ] || {
        echo "FATAL: base .tags missing"
        exit 1
    }

    echo "$W/$PFX"
}

tier0b() {    # $1 = csv ; print res, recall, forced_drains, deferred_backlog, sla_violations
    awk -F, '
        $1 !~ /^#/ &&
        $1 != "timestamp" &&
        $2 >= 1 &&
        $3 == -1 {
            print "res="$4 \
                  " recall@10="$10 \
                  " forced="$(NF-4) \
                  " backlog="$(NF-3) \
                  " overflow="$(NF-2) \
                  " maxstale["$(NF-1)"]" \
                  " viol["$NF"]"
        }
    ' "$1"
}
# ------------------------------------------------------------ ANCHOR ------------------------------------------------->

if [ "$MODE" = anchor ]; then

    GT=${ANCHOR_GT:-$ROOT/work/sift100k_gt_inserts_only}    # unfiltered GT (single label => inert)

    run_anchor() {    # $1 tag ; $2 sched-mode ; $3 sla_file ("" => disabled)
        local TAG=$1
        local SCHED=$2
        local SLA=$3

        local W=$ROOT/work/2e_anchor_$TAG
        local SAVE
        SAVE=$(seed_save "$W")

        local CSV=$W/anchor.csv
        rm -f "$CSV"

        echo "===== ANCHOR [$TAG] sched=$SCHED sla_file=${SLA:-<none>} ====="
        echo "=== GT dir [$GT] ==="

        for ckpt in 0 1 2 3; do
            local envs=(
                INSERTS_ONLY=1
                C2_DISK_POSTFILTER=0
                C2_L_PRED=1
                C2_T_CNT=1
                C3_HIGH_WATER=$MS
                C3_B=$MS
                TELEMETRY_CSV="$CSV"
            )

            [ -n "$SLA" ] && envs+=(C3_SLA_FILE="$SLA")

            env "${envs[@]}" \
                "$BT/overall_performance" \
                float \
                "$DATA/sift_base.bin" \
                75 32 1.2 "$N0" 0 \
                "$SAVE" \
                "$QUERY" \
                "$GT" \
                10 4 "$STEP" "$ckpt" "$MS" 75 \
                --cache-mode filter-tenant \
                --sched-mode "$SCHED" \
                >"$W/ckpt${ckpt}.log" 2>&1 || true
        done
        echo "--- ceiling banner (confirms load) ---"; grep -h "ceiling_enabled\|C3-ceiling" "$W"/ckpt*.log | head -3 || true
        echo "--- Tier-0b (expect 98.542 / 98.282 / 98.000) ---"
        tier0b "$CSV"
    }
    # leg 1: ceiling DISABLED (old select_batch path) - priority
    run_anchor disabled priority ""

    # leg 2: ceiling >= horizon (new select_batch_ceiling, never fires) - priority
    SLAHZ=$ROOT/work/2e_anchor_hz_sla.txt
    printf '0 lax 1000000000\n' >"$SLAHZ"
    run_anchor ge_horizon priority "$SLAHZ"

    # leg 3: fifo byte-parity
    run_anchor fifo fifo ""

    exit 0
fi
# ---------------------------------------------------------- FUNCTIONAL ----------------------------------------------->

if [ "$MODE" = functional ]; then

    WORKROOT=$ROOT/work/2e
    CFG=$WORKROOT/2E_config.json

    [ -f "$CFG" ] || {
        echo "FATAL: run gen_2e_workload.py first ($CFG missing)"
        exit 1
    }

    SLA=$WORKROOT/2E_sla_map.txt
    python3 "$(dirname "$0")/ceiling_map.py" \
        --config "$CFG" \
        --out "$SLA"
    echo "--- SLA map ($SLA) ---"; cat "$SLA"
    echo "--- binary has ceiling code? (expect > 0) ---"
    strings "$BT/overall_performance" | grep -c "C3-ceiling" || true

    PLGT=$WORKROOT/perlabel_gt

    W=$ROOT/work/2e_func
    SAVE=$(seed_save "$W")

    CSV=$W/func.csv
    rm -f "$CSV"

    STATE=$W/sched_state

    HW=40000    # high_water = 2*B => total staged can exceed B => DEFERRAL happens

    echo "===== FUNCTIONAL: tight ceiling fires + deferral + durability ====="

    # ckpt 0..2: each restart reloads, ages deferred units past the tight ceiling.
    for ckpt in 0 1 2; do
        TO=""
        [ "$ckpt" -ge 1 ] && TO="timeout 300"
        P3=$W/p3_c$ckpt
        mkdir -p "$P3"

        $TO env \
            INSERTS_ONLY=1 \
            C2_L_PRED=6 \
            C2_T_CNT=6 \
            C2_LABELS_FILE="$WORKROOT/2E_labels.txt" \
            C2_TENANTS_FILE="$WORKROOT/2E_tenants.txt" \
            C2_QUERY_LABELS_FILE="$WORKROOT/2E_query_labels.txt" \
            C2_QUERY_TENANTS_FILE="$WORKROOT/2E_query_tenants.txt" \
            C3_HIGH_WATER=$HW \
            C3_B=$MS \
            C3_SLA_FILE="$SLA" \
            SCHED_STATE_FILE="$STATE" \
            TELEMETRY_CSV="$CSV" \
            P3_DUMP="$P3" \
            "$BT/overall_performance" \
            float \
            "$DATA/sift_base.bin" \
            75 32 1.2 "$N0" 0 \
            "$SAVE" \
            "$QUERY" \
            "$PLGT" \
            10 4 "$STEP" "$ckpt" "$MS" 75 \
            --cache-mode filter-tenant \
            --sched-mode priority \
            >"$W/ckpt${ckpt}.log" 2>&1 || true

        echo "--- ckpt $ckpt: ceiling banner + fire / overflow / persistence lines ---"

        grep -E \
            "ceiling_enabled|C3-ceiling|ceiling_forced_overflow|C3-3b|\[C3\] drain" \
            "$W/ckpt${ckpt}.log" | head -20 || true
    done

    echo "=== merge-boundary telemetry (forced_drains, deferred_backlog, tiers) ==="

    awk -F, '
        $1 !~ /^#/ &&
        $1 != "timestamp" &&
        $17 == 1 {
            print "res="$4 \
                  " forced="$(NF-4) \
                  " backlog="$(NF-3) \
                  " overflow="$(NF-2) \
                  " maxstale["$(NF-1)"]" \
                  " viol["$NF"]"
        }
    ' "$CSV" || true

    echo "=== all rows: sla_violations_by_tier (last col) ==="

    awk -F, '
        $1 !~ /^#/ &&
        $1 != "timestamp" {
            print "res="$4 " viol="$NF
        }
    ' "$CSV" || true

    echo "csv: $CSV    STATE: $STATE (+ staging if deferred)"
    exit 0
fi

echo "usage: $0 {anchor|functional}"
exit 2
