 #!/usr/bin/env bash
set -euo pipefail

MODE="${1:-step0}"

ROOT=~/research
REPO=$ROOT/FreshDiskANN-baseline
BT=$REPO/build/tests
DATA=$ROOT/data/sift1m
QUERY=$DATA/sift_query.bin

WORKROOT=$ROOT/work/2e
CFG=$WORKROOT/2E_config.json
SLA=$WORKROOT/2E_sla_map.txt

PLGT=$WORKROOT/perlabel_gt          # A's per-label GT (res 20/40/60K)
ANCHOR_GT=$ROOT/work/sift100k_gt_anchor_k100   # unfiltered K=100 2-block GT

N0=100000
STEP=100

HW=10000
B=5000                              # <-- the locked regime (Finding 2: HW=tight_ceiling)

MERGES="0 1 2 3 4 5 6"              # res = ckpt*HW = 0,10,20,30,40,50,60K; GT at 20/40/60

[ -f "$CFG" ] || { echo "FATAL: $CFG missing (run gen_2e_workload.py)"; exit 1; }

python3 "$(dirname "$0")/ceiling_map.py" --config "$CFG" --out "$SLA"

echo "--- SLA map ---"
cat "$SLA"

echo "--- binary ceiling code present? (expect >0) ---"
strings "$BT/overall_performance" | grep -c "C3-ceiling" || true

seed_save() {    # $1 = work dir -> echoes SAVE prefix
    local W="$1" G0 PFX

    G0=$(ls "$ROOT/work/sift100k_idx"/*_disk.index | head -1)
    G0=${G0%_disk.index}

    PFX=$(basename "$G0")

    rm -rf "$W"
    mkdir -p "$W"

    for s in \
        _disk.index \
        _disk.index.tags \
        _pq_compressed.bin \
        _pq_pivots.bin \
        _medoids.bin \
        _sample_data.bin
    do
        [ -f "${G0}${s}" ] && cp -f "${G0}${s}" "$W/${PFX}${s}"
    done

    rm -f \
        "$W/${PFX}"_mem* \
        "$W/${PFX}"_merge* \
        "$W/${PFX}"_shadow* \
        2>/dev/null || true

    [ -f "$W/${PFX}_disk.index.tags" ] || {
        echo "FATAL: base .tags missing (gen_tags)"
        exit 1
    }

    echo "$W/$PFX"
}

run_leg() {
    local TAG=$1 GT=$2 PF=$3 EXTRA=$4
    local W=$ROOT/work/2e_win_$TAG
    local SAVE
    SAVE=$(seed_save "$W")

    local CSV=$W/$TAG.csv
    rm -f "$CSV"

    local STATE=$W/sched_state

    echo "===== LEG [$TAG] GT=$(basename "$GT") postfilter=${PF:-default} extra='$EXTRA' ====="

    for ckpt in $MERGES; do
        local TO=""
        [ "$ckpt" -ge 1 ] && TO="timeout 300"

        local PFENV=()
        [ -n "$PF" ] && PFENV=( C2_DISK_POSTFILTER=$PF )

        $TO env INSERTS_ONLY=1 \
            C2_L_PRED=6 C2_T_CNT=6 \
            C2_LABELS_FILE="$WORKROOT/2E_labels.txt" \
            C2_TENANTS_FILE="$WORKROOT/2E_tenants.txt" \
            C2_QUERY_LABELS_FILE="$WORKROOT/2E_query_labels.txt" \
            C2_QUERY_TENANTS_FILE="$WORKROOT/2E_query_tenants.txt" \
            C3_HIGH_WATER=$HW C3_B=$B C3_SLA_FILE="$SLA" \
            SCHED_STATE_FILE="$STATE" TELEMETRY_CSV="$CSV" \
            "${PFENV[@]}" $EXTRA \
            "$BT/overall_performance" float "$DATA/sift_base.bin" 75 32 1.2 "$N0" 0 \
            "$SAVE" "$QUERY" "$GT" 10 4 "$STEP" "$ckpt" "$B" 75 \
            --cache-mode filter-tenant --sched-mode priority \
            >"$W/ckpt${ckpt}.log" 2>&1 || true

        grep -E "ceiling_enforce|C3-ceiling|forced_overflow|\[C3\] drain" \
            "$W/ckpt${ckpt}.log" | head -6 || true
    done
    echo "--- Tier-0b by-tier (res, recall, forced, backlog, maxstale, viol) ---"

    awk -F, '$1!~/^#/ && $1!="timestamp" && $2>=1 && $3==-1 \
    {print "res="$4" recall@10="$10" forced="$(NF-4)" backlog="$(NF-3)\
    " overflow="$(NF-2)" maxstale["$(NF-1)"] viol["$NF"]"}' "$CSV"

    echo "--- merge-boundary (forced/backlog/overflow) ---"

    awk -F, '$1!~/^#/ && $1!="timestamp" && $17==1 \
    {print "res="$4" forced="$(NF-4)" backlog="$(NF-3)" overflow="$(NF-2)" maxstale["$(NF-1)"]"}' "$CSV"
    echo "CSV: $CSV"
}

case "$MODE" in

step0|headline)
    # Both legs on A's frozen config. STEP-0 GATE reads:
    #   enforce: forced>0, maxstale[tight]~10000, lax backlog grows, no lax forced
    #   fifo   : viol[tight] > 0 <-- if ~0; NO CONTENTION -> re-freeze low-lambda (see notes)

    run_leg enforce "$PLGT" "" ""
    run_leg fifo "$PLGT" "" "C3_CEILING_MEASURE_ONLY=1 C3_ALPHA3=0"

    echo
    echo "### STEP-0 GATE: fifo-leg viol[tight] MUST be >0 for a valid verdict. ###"
    ;;

aggregate)
    # Step 4: same stream/HW/B, post-filter OFF, scored vs unfiltered anchor GT.
    # Reference (re-baselined anchor): 99.286 / 99.145 / 99.018 at res 20/40/60K.

    run_leg agg_enforce "$ANCHOR_GT" 0 ""
    run_leg agg_fifo "$ANCHOR_GT" 0 "C3_CEILING_MEASURE_ONLY=1 C3_ALPHA3=0"

    echo
    echo "### On-curve: agg recall delta (enforce - fifo) ~0 and near anchor. ###"
    ;;

*)
    echo "usage: $0 {step0|headline|aggregate}"
    exit 2
    ;;
esac
