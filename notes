2b6_10000_c500 R_merge=-1
2b6_10000_c2500 R_merge=-1
2b6_100000_c25000 R_merge=-1
2b6_10000_c1000 R_merge=-1
2b6_100000_c5000 R_merge=-1
2b6_100000_c10000 R_merge=-1


cd ~/research

DATA=data/sift1m
WORK=work
BT=~/research/FreshDiskANN-baseline/build/tests
QUERY=$DATA/sift_query.bin

run_cell() {    # $1=N0  $2=GO_prefix  $3=step  $4=c
    local N0=$1 GO=$2 STEP=$3 c=$4 PFX
    PFX=$(basename "$GO")
    local live=$((N0+c))

    local GTDIR=$WORK/2b6_gt_${N0}
    mkdir -p "$GTDIR" "$WORK/logs"

    local slice=$DATA/sift_base_${live}.bin

    [ -f "$slice" ] || python3 - "$live" <<'PY'
import struct, numpy as np, os, sys

N = int(sys.argv[1])
SRC = os.path.expanduser('~/research/data/sift1m/sift_base.bin')

with open(SRC, 'rb') as f:
    n, d = struct.unpack('<ii', f.read(8))
    a = np.frombuffer(f.read(N*d*4), np.float32).reshape(N, d)

OUT = os.path.expanduser(f'~/research/data/sift1m/sift_base_{N}.bin')
open(OUT, 'wb').write(struct.pack('<ii', N, d) + a.tobytes())
print("sliced", OUT, N)
PY

    if [ ! -f "$GTDIR/gt_${c}.bin" ]; then
        $BT/utils/compute_groundtruth \
            float 12 \
            "$slice" \
            "$QUERY" \
            100 \
            "$GTDIR/gt_${c}.bin" \
            null \
            null

        python3 - "$GTDIR/gt_${c}.bin" <<'PY'
import numpy as np, os, sys

f = sys.argv[1]

with open(f, 'rb') as fh:
    n, d = (int(x) for x in np.fromfile(fh, np.int32, count=2))
    ids = np.fromfile(fh, np.uint32, count=n*d)
    di = np.fromfile(fh, np.float32, count=n*d)

if os.path.getsize(f) != 8 + n*d*8:
    open(f, 'wb').write(
        np.array([n, d], np.int32).tobytes() +
        ids.tobytes() +
        di.tobytes()
    )

print("stripped 2-block", f)
PY
    fi

    local W=$WORK/2b6_${N0}_c${c}
    rm -rf "$W"
    mkdir -p "$W"

    for s in \
        _disk.index \
        _disk.index.tags \
        _pq_compressed.bin \
        _pq_pivots.bin \
        _medoids.bin \
        _sample_data.bin
    do
        [ -f "${GO}${s}" ] && cp -f "${GO}${s}" "$W/${PFX}${s}"
    done

    local SAVE=$W/$PFX
    rm -f ${SAVE}_mem* ${SAVE}_merge* ${SAVE}_shadow* 2>/dev/null

    INSERTS_ONLY=1 \
    C2_DISK_POSTFILTER=0 \
    TELEMETRY_CSV=$W/m.csv \
    $BT/overall_performance \
        float \
        $DATA/sift_base.bin \
        75 32 1.2 \
        $N0 0 \
        $SAVE \
        $QUERY \
        $GTDIR \
        10 4 \
        $STEP \
        0 \
        $c \
        75 \
        2>&1 | tee $WORK/logs/2b6_${N0}_c${c}_ck0.log

    timeout 200 env \
        INSERTS_ONLY=1 \
        C2_DISK_POSTFILTER=0 \
        TELEMETRY_CSV=$W/m.csv \
        $BT/overall_performance \
            float \
            $DATA/sift_base.bin \
            75 32 1.2 \
            $N0 0 \
            $SAVE \
            $QUERY \
            $GTDIR \
            10 4 \
            $STEP \
            1 \
            $c \
            75 \
            2>&1 | tee $WORK/logs/2b6_${N0}_c${c}_ck1.log

    echo "CELL N0=$N0 c=$c live=$live R_merge=$(awk -F, 'NR>1 && $2==1 && $3==-1 {print $10; exit}' $W/m.csv)"
}

G10=$(ls $WORK/sift10k_idx/*_disk.index | head -1)
G10=${G10%_disk.index}

G100=$(ls $WORK/sift100k_idx/*_disk.index | head -1)
G100=${G100%_disk.index}

for c in 500 1000 2500; do
    run_cell 10000 "$G10" 1000 $c
done

for c in 5000 10000 25000; do
    run_cell 100000 "$G100" 10000 $c
done
