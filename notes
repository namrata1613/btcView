Input script - 
cd ~/research

DATA=data/sift1m
WORK=work
BT=~/research/FreshDiskANN-baseline/build/tests
GTDIR=$WORK/2b3_gt

G0=$(ls $WORK/sift10k_idx/*_disk.index | head -1)
G0=${G0%_disk.index}
PFX=$(basename "$G0")

c=1000
W=$WORK/2b3_c${c}
P3=$W/p3
mkdir -p "$P3"

rm -f $W/2b3_c${c}.csv    # drop the stale -1 rows so the scraper is clean

# ckpt1 only: reloads the existing _merge, measures Tier-0b, then would keep going.
# 150s is enough for the pre-insert measurement; kill before the wasteful 2nd merge (~15 min later).
timeout 150 env \
INSERTS_ONLY=1 \
C2_DISK_POSTFILTER=0 \
P3_DUMP=$P3 \
TELEMETRY_CSV=$W/2b3_c${c}.csv \
$BT/overall_performance float \
    $DATA/sift_base.bin \
    75 32 1.2 \
    10000 0 \
    $W/$PFX \
    $DATA/sift_query.bin \
    $GTDIR \
    10 4 1000 1 ${c} 75 \
    2>&1 | tee $WORK/logs/2b3_dbg2.log

echo "== stdout recall table (authoritative R_merge) =="

grep -E "Recall@10|^\s*75" $WORK/logs/2b3_dbg2.log
echo "== ckpt1 Tier-0b CSV row (batch_idx=-1) =="

awk -F, 'NR>1 && $2==1 && $3==-1 {print "recall_at_10="$10}' \
    $W/2b3_c${c}.csv
echo "== returned tag space (should be [0,11000)) =="

python3 - <<'PY'
import numpy as np
import os

f = "work/2b3_c1000/p3/L_75.u32"

if not os.path.exists(f):
    print("dump not written yet (search still running)")
    raise SystemExit

a = np.fromfile(f, dtype=np.uint32)
nq, k = int(a[0]), int(a[1])
t = a[2:2 + nq * k].reshape(nq, k)

v = t[t != 0xFFFFFFFF]

print("q0 tags:", t[0].tolist())
print("frac empty(UINT_MAX):", round((t == 0xFFFFFFFF).mean(), 4))
print(
    "tag range:",
    (int(v.min()), int(v.max())) if v.size else None
)
PY
